# ── Email Triage OpenEnv — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM API (for inference.py) ────────────────────────────────────────────────

# HuggingFace Inference API (default)
API_BASE_URL=https://api-inference.huggingface.co/v1
MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
HF_TOKEN=hf_your_token_here

# OpenAI (alternative)
# API_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# HF_TOKEN=sk-your-openai-key-here

# ── Environment Server ────────────────────────────────────────────────────────

# URL of the FastAPI environment server
ENV_BASE_URL=http://localhost:8000

# Port for the server (used in Docker)
PORT=8000

# Directory to write episode log files
LOG_DIR=./logs
